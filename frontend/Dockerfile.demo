FROM docker.io/library/node:24-alpine AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src/ src/
COPY demo/ demo/
COPY demo.html vite.demo.config.js ./
ENV SPLITSMART_DEMO_ONLY=synthetic-v1
RUN node demo/build.mjs

FROM docker.io/library/node:24-alpine
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/dist-demo/ /app/dist-demo/
COPY --from=build --chown=10001:10001 /build/demo/server.mjs /build/demo/policy.mjs /app/demo/
USER 10001:10001
ENV SPLITSMART_DEMO_ONLY=synthetic-v1 DEMO_BIND_ADDRESS=0.0.0.0 PORT=8080
CMD ["node", "demo/server.mjs"]
